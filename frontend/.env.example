# ════════════════════════════════════════════════════
#  OneOps Frontend — Environment Variables
#  Copy this file to .env.local and fill in the values
#  cp .env.example .env.local
# ════════════════════════════════════════════════════

# ── Backend API URL ───────────────────────────────────
# Your deployed backend Vercel project URL.
# Used ONLY server-side (Next.js proxy route) — never sent to the browser.
# Local dev: http://localhost:4000
# Production: https://oneops-api.vercel.app  (your backend Vercel project)
API_URL=http://localhost:4000

# ── App URL (for Next.js Server Actions) ─────────────
# Your frontend Vercel domain — no trailing slash.
# Required in production so Server Actions know the allowed origin.
# Local dev: leave empty (defaults to localhost)
# Production: https://oneops-frontend.vercel.app  (your frontend Vercel project)
NEXT_PUBLIC_APP_URL=
