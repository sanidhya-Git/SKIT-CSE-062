# ── Shared Secret (frontend → ai-engine auth) ─────────────────
ONEOPS_API_SECRET=change-me-in-production-use-256bit-random

# ── AI Providers ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# Provider priority (first = primary, others = fallback)
AI_PROVIDER_ORDER=openai,claude,gemini

# ── Salesforce ────────────────────────────────────────────────
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_ORG_URL=https://yourorg.my.salesforce.com

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
