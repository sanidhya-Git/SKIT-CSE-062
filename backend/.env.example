# ════════════════════════════════════════════════════
#  OneOps API — Environment Variables
#  Copy this file to .env and fill in the values
#  cp .env.example .env
# ════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── CORS — Frontend URL ───────────────────────────────
# Your frontend Vercel project URL.
# Comma-separated list if you have multiple origins (staging, preview, etc.)
# All *.vercel.app preview URLs are automatically allowed by the CORS config.
FRONTEND_URL=https://oneops-frontend.vercel.app

# ── Database (REQUIRED) ───────────────────────────────
# PostgreSQL connection string.
# Recommended: Neon (https://neon.tech) — serverless-compatible, free tier available.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/oneops?sslmode=require

# ── Redis (REQUIRED) ──────────────────────────────────
# Redis connection string.
# Recommended: Upstash (https://upstash.com) — serverless-compatible, free tier available.
# Format: redis://default:password@host:port
REDIS_URL=redis://default:password@host:6379

# ── JWT (REQUIRED) ────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Credential Encryption (REQUIRED) ─────────────────
# Must be exactly 64 hex characters (= 32 bytes for AES-256-GCM).
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# ── Webhook Signing (REQUIRED) ────────────────────────
# HMAC secret used to sign outgoing webhook payloads.
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── AI Providers ──────────────────────────────────────
# At least one provider key is required for AI features.
# Priority order: first provider with a key wins.
AI_PROVIDER_ORDER=anthropic,openai,gemini

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# ── Rate Limiting (optional — defaults shown) ─────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# ── Logging (optional) ────────────────────────────────
LOG_LEVEL=info

# ── BullMQ (optional) ─────────────────────────────────
# NOTE: BullMQ workflow workers do NOT run on Vercel (stateless serverless).
# Workflow jobs are queued in Redis but won't be processed automatically.
# To process workflows, run the API on a persistent host (Railway, Fly.io, Render).
BULLMQ_CONCURRENCY=5
